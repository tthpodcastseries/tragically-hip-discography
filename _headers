/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://sdk.scdn.co https://unpkg.com https://cloud.umami.is; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https://*.basemaps.cartocdn.com https://unpkg.com https://i.scdn.co https://mosaic.scdn.co https://i.ytimg.com; connect-src 'self' https://fonts.googleapis.com https://accounts.spotify.com https://api.spotify.com https://api.lyrics.ovh https://*.supabase.co https://*.backblazeb2.com https://gateway.umami.is; media-src 'self' https://*.backblazeb2.com; manifest-src 'self'

/scripts/*
  X-Robots-Tag: noindex, nofollow

/service-worker.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.json
  Cache-Control: max-age=3600

# Images keep for a week. Replace an image under a new file name, never overwrite it.
# Pages, CSS, JS and data keep Netlify's default (check for changes every time),
# because their file names never change between releases.
/assets-optimized/*
  Cache-Control: public, max-age=604800

/icons/*
  Cache-Control: public, max-age=604800
