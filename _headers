# Content-Security-Policy (audit SEC-03, v5.4.17; tightened in audit SEC-10): no inline
# scripts or onclick= handlers anywhere - put code in /js/ files. Leaflet is our own copy
# (/js/vendor/, /css/vendor/). Outside hosts, each named exactly: Umami (the one
# cloud.umami.is script, gateway.umami.is events), CARTO map tiles (a-d), YouTube thumbnails
# (i.ytimg.com), our Supabase project (membersHIP) and our Backblaze server (live audio,
# played by the <audio> element, so media-src only). Fonts are our own.
# scripts/audit-site.js checks there is no 'unsafe-inline' in script-src, and that every
# outside script and image host a page uses is allowed here.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cloud.umami.is/script.js; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://a.basemaps.cartocdn.com https://b.basemaps.cartocdn.com https://c.basemaps.cartocdn.com https://d.basemaps.cartocdn.com https://i.ytimg.com; connect-src 'self' https://deqslacywpwnjjckdygp.supabase.co https://gateway.umami.is; media-src 'self' https://f006.backblazeb2.com; manifest-src 'self'; worker-src 'self'; frame-src 'none'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/scripts/*
  X-Robots-Tag: noindex, nofollow

/service-worker.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.json
  Cache-Control: max-age=3600

# Images keep for a week. Replace an image under a new file name, never overwrite it.
# Pages, CSS, JS and data keep Netlify's default (check for changes every time),
# because their file names never change between releases.
/assets-optimized/*
  Cache-Control: public, max-age=604800

/icons/*
  Cache-Control: public, max-age=604800

/fonts/*
  Cache-Control: public, max-age=604800
