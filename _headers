# Content-Security-Policy (audit SEC-03, v5.4.17): no inline scripts or onclick= handlers
# anywhere - put code in /js/ files. Outside hosts: unpkg (Leaflet, map pages), Umami
# (cloud.umami.is script, gateway.umami.is events), CARTO map tiles, YouTube thumbnails
# (i.ytimg.com), Supabase (membersHIP) and Backblaze (live audio). Fonts are our own.
# scripts/audit-site.js checks there is no 'unsafe-inline' in script-src.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://unpkg.com https://cloud.umami.is; style-src 'self' 'unsafe-inline' https://unpkg.com; font-src 'self'; img-src 'self' data: blob: https://*.basemaps.cartocdn.com https://unpkg.com https://i.ytimg.com; connect-src 'self' https://*.supabase.co https://*.backblazeb2.com https://gateway.umami.is; media-src 'self' https://*.backblazeb2.com; manifest-src 'self'; worker-src 'self'; frame-src 'none'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/scripts/*
  X-Robots-Tag: noindex, nofollow

/service-worker.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.json
  Cache-Control: max-age=3600

# Images keep for a week. Replace an image under a new file name, never overwrite it.
# Pages, CSS, JS and data keep Netlify's default (check for changes every time),
# because their file names never change between releases.
/assets-optimized/*
  Cache-Control: public, max-age=604800

/icons/*
  Cache-Control: public, max-age=604800

/fonts/*
  Cache-Control: public, max-age=604800
